# Credenciais da mesma aplicação criada no Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
VITE_DISCORD_CLIENT_ID=

# HTTP. Em produção, PORT costuma ser injetada pelo provedor.
HOST=127.0.0.1
PORT=3001
PUBLIC_BASE_URL=http://localhost:5173

# Origens aceitas no upgrade do WebSocket, separadas por vírgula.
# Inclua https://<APPLICATION_ID>.discordsays.com em produção.
ALLOWED_ORIGINS=http://localhost:5173

# Sessões ficam apenas em memória neste MVP.
SESSION_TTL_SECONDS=3600
CAPTURE_TOKEN_TTL_SECONDS=120

# Não é necessário STUN/TURN: a mídia codificada é retransmitida por WSS.
# Para o túnel local, sobrescreva PUBLIC_BASE_URL em .env.local.

# Preview visual fora do Discord. Não autentica nem transmite.
VITE_ENABLE_BROWSER_PREVIEW=true
